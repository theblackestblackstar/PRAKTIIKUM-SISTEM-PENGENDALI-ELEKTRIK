        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TB\n subgraph INIT[\&quot;I. SYSTEM INITIALIZATION &amp; SETUP\&quot;]\n        I_P1{{\&quot;Preparation: Init RCC&lt;br&gt;RCC-&amp;gt;CFGR &amp;amp; System Clock\&quot;}}\n        I_S([\&quot;Start: Power-On / Reset\&quot;])\n        I_F1[[\&quot;hw_init()\&quot;]]\n        I_F2[[\&quot;MX_GPIO_Init()\&quot;]]\n        I_R1[\&quot;Konfigurasi TIM1 PWM Center-Aligned&lt;br&gt;TIM1-&amp;gt;CR1, TIM1-&amp;gt;ARR, TIM1-&amp;gt;PSC\&quot;]\n        I_R2[\&quot;Konfigurasi ADC Injected + DMA&lt;br&gt;ADC1-&amp;gt;SQR1, DMA1_Channel1&lt;br&gt;(sampling arus 3-fasa)\&quot;]\n        I_F3[[\&quot;NVIC_SetPriority()&lt;br&gt;untuk TIM1_UP_IRQHandler\&quot;]]\n        I_F4[[\&quot;chSysInit()&lt;br&gt;Init RTOS Kernel\&quot;]]\n        I_F5[[\&quot;mc_interface_init()&lt;br&gt;Init modul VESC\&quot;]]\n        I_A((\&quot;A\&quot;))\n        I_E([\&quot;End Init\&quot;])\n  end\n subgraph MAIN[\&quot;II. MAIN LOOP / TASK SCHEDULER\&quot;]\n        M_S([\&quot;Thread Loop / Super-Loop while 1\&quot;])\n        M_A((\&quot;A\&quot;))\n        M_IO1[/\&quot;Baca stream data UART/USB&lt;br&gt;(VESC Protocol Buffer)\&quot;/]\n        M_F1[[\&quot;commands_process_packet()\&quot;]]\n        M_D1{\&quot;Paket data valid?\&quot;}\n        M_R1[\&quot;Update target_speed,&lt;br&gt;target_current, target_voltage\&quot;]\n        M_R2[\&quot;Abaikan paket &amp;amp;&lt;br&gt;flush buffer\&quot;]\n        M_R3[\&quot;Filter LPF pada input kecepatan\&quot;]\n        M_F2[[\&quot;mc_interface_set_pid_speed()&lt;br&gt;Hitung setpoint torsi/kecepatan\&quot;]]\n        M_B((\&quot;B\&quot;))\n  end\n subgraph ISR[\&quot;III. HIGH-FREQUENCY ISR\&quot;]\n        H_IO1[/\&quot;Baca ADC Injected&lt;br&gt;ADC1-&amp;gt;JDR1, ADC1-&amp;gt;JDR2&lt;br&gt;menghasilkan Ia, Ib\&quot;/]\n        H_S([\&quot;Start ISR: TIM1_UP_IRQHandler / ADC1_2_IRQHandler\&quot;])\n        H_P1[\&quot;Transformasi Clarke&lt;br&gt;Iα = Ia&lt;br&gt;Iβ = (1/√3)·Ia + (2/√3)·Ib\&quot;]\n        H_P2[\&quot;Transformasi Park (sudut rotor θ)&lt;br&gt;Id = Iα·cosθ + Iβ·sinθ&lt;br&gt;Iq = -Iα·sinθ + Iβ·cosθ\&quot;]\n        H_F1[[\&quot;Loop Kontrol PI Regulator&lt;br&gt;untuk Id dan Iq\&quot;]]\n        H_P3[\&quot;Transformasi Inverse Park&lt;br&gt;&amp;amp; Kalkulasi Duty Cycle SVPWM\&quot;]\n        H_P4[\&quot;Tulis register perbandingan PWM&lt;br&gt;TIM1-&amp;gt;CCR1, TIM1-&amp;gt;CCR2, TIM1-&amp;gt;CCR3\&quot;]\n        H_E([\&quot;Exit ISR\&quot;])\n  end\n subgraph SAFETY[\&quot;IV. FAULT HANDLING &amp; SAFETY ROUTINE\&quot;]\n        F_D1{\&quot;I_measured ﬂ°gt¶ß I_OCP_LIMIT?&lt;br&gt;(Over-Current)\&quot;}\n        F_S([\&quot;Start: Fault Check\&quot;])\n        F_D2{\&quot;Vdc ﬂ°lt¶ß V_MIN ATAU Vdc ﬂ°gt¶ß V_MAX?&lt;br&gt;(Under/Over-Voltage)\&quot;}\n        F_D3{\&quot;T_mosfet ﬂ°gt¶ß T_MAX?&lt;br&gt;(Over-Temperature)\&quot;}\n        F_OK([\&quot;End: Kondisi Normal\&quot;])\n        F_X((\&quot;F\&quot;))\n        F_P1[\&quot;Reset Main Output Enable&lt;br&gt;TIM1-&amp;gt;BDTR |= TIM_BDTR_MOE_RESET\&quot;]\n        F_F1[[\&quot;stop_motor()\&quot;]]\n        F_P2[\&quot;Set flag MC_FAULT_STATE\&quot;]\n        F_IO1[/\&quot;Kirim error log&lt;br&gt;ke VESC Tool interface\&quot;/]\n        F_E([\&quot;End: Fault State\&quot;])\n  end\n    I_S --&gt; I_P1\n    I_P1 --&gt; I_F1\n    I_F1 --&gt; I_F2\n    I_F2 --&gt; I_R1\n    I_R1 --&gt; I_R2\n    I_R2 --&gt; I_F3\n    I_F3 --&gt; I_F4\n    I_F4 --&gt; I_F5\n    I_F5 --&gt; I_A\n    I_A --&gt; I_E\n    M_A --&gt; M_S\n    M_S --&gt; M_IO1\n    M_IO1 --&gt; M_F1\n    M_F1 --&gt; M_D1\n    M_D1 -- Ya --&gt; M_R1\n    M_D1 -- Tidak --&gt; M_R2\n    M_R1 --&gt; M_R3\n    M_R2 --&gt; M_R3\n    M_R3 --&gt; M_F2\n    M_F2 --&gt; M_B\n    M_B -. ulangi loop .-&gt; M_S\n    I_E -. lanjut ke Main Loop .-&gt; M_A\n    H_S --&gt; H_IO1\n    H_IO1 --&gt; H_P1\n    H_P1 --&gt; H_P2\n    H_P2 --&gt; H_F1\n    H_F1 --&gt; H_P3\n    H_P3 --&gt; H_P4\n    H_P4 --&gt; H_E\n    F_S --&gt; F_D1\n    F_D1 -- Tidak --&gt; F_D2\n    F_D2 -- Tidak --&gt; F_D3\n    F_D3 -- Tidak --&gt; F_OK\n    F_D1 -- Ya --&gt; F_X\n    F_D2 -- Ya --&gt; F_X\n    F_D3 -- Ya --&gt; F_X\n    F_X --&gt; F_P1\n    F_P1 --&gt; F_F1\n    F_F1 --&gt; F_P2\n    F_P2 --&gt; F_IO1\n    F_IO1 --&gt; F_E\n\n     I_P1:::prep\n     I_S:::term\n     I_F1:::pre\n     I_F2:::pre\n     I_R1:::proc\n     I_R2:::proc\n     I_F3:::pre\n     I_F4:::pre\n     I_F5:::pre\n     I_E:::term\n     M_S:::term\n     M_IO1:::io\n     M_F1:::pre\n     M_D1:::dec\n     M_R1:::proc\n     M_R2:::proc\n     M_R3:::proc\n     M_F2:::pre\n     H_IO1:::io\n     H_S:::term\n     H_P1:::proc\n     H_P2:::proc\n     H_F1:::pre\n     H_P3:::proc\n     H_P4:::proc\n     H_E:::term\n     F_D1:::dec\n     F_S:::term\n     F_D2:::dec\n     F_D3:::dec\n     F_OK:::term\n     F_P1:::proc\n     F_F1:::pre\n     F_P2:::proc\n     F_IO1:::io\n     F_E:::term\n    classDef term fill:#d5e8d4,stroke:#82b366\n    classDef prep fill:#fff2cc,stroke:#d6b656\n    classDef proc fill:#dae8fc,stroke:#6c8ebf\n    classDef pre fill:#e1d5e7,stroke:#9673a6\n    classDef dec fill:#f8cecc,stroke:#b85450\n    classDef io fill:#ffe6cc,stroke:#d79b00&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="UTx_F3CK04s2m_RHuv5F-1">
