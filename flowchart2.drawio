        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TB\n subgraph INIT[\&quot;I. SYSTEM INITIALIZATION &amp; SETUP\&quot;]\n        I_S([\&quot;Start: Power-On / Reset\&quot;])\n        I_F1[[\&quot;HAL_Init()\&quot;]]\n        I_F2[[\&quot;SystemClock_Config()&lt;br&gt;Clock 72 MHz\&quot;]]\n        I_F3[[\&quot;MX_GPIO_Init()\&quot;]]\n        I_F4[[\&quot;MX_TIM1_Init()\&quot;]]\n        I_F5[[\&quot;MX_ADC1_Init()\&quot;]]\n        I_F6[[\&quot;MX_DMA_Init()\&quot;]]\n        I_R1[\&quot;Setup TIM1: TIM1-&amp;gt;PSC, TIM1-&amp;gt;ARR&lt;br&gt;PWM Komplementer + Deadtime Insertion\&quot;]\n        I_R2[\&quot;Setup ADC1-&amp;gt;CR2&lt;br&gt;Trigger Source dari TIM1_TRGO\&quot;]\n        I_F7[[\&quot;HAL_ADC_Start_DMA()\&quot;]]\n        I_F8[[\&quot;HAL_TIM_PWM_Start()\&quot;]]\n        I_E([\&quot;End Init\&quot;])\n  end\n subgraph MAIN[\&quot;II. MAIN LOOP / TASK SCHEDULER\&quot;]\n        M_S([\&quot;main() Super-Loop while 1\&quot;])\n        M_IO1[/\&quot;Baca Throttle &amp; Brake Analog&lt;br&gt;atau UART Panel Command\&quot;/]\n        M_R1[\&quot;Normalisasi ADC 0-4095&lt;br&gt;menjadi Target Command 0.0 - 1.0f\&quot;]\n        M_D1{\&quot;Control Mode?\&quot;}\n        M_R2[\&quot;Referensi: Voltage Mode\&quot;]\n        M_R3[\&quot;Referensi: Speed Mode\&quot;]\n        M_R4[\&quot;Referensi: Torque Mode\&quot;]\n        M_F1[[\&quot;controller()&lt;br&gt;Kalkulasi target referensi FOC\&quot;]]\n  end\n subgraph ISR[\&quot;III. HIGH-FREQUENCY ISR\&quot;]\n        H_S([\&quot;Start ISR: HAL_ADC_ConvCpltCallback / TIM1_UP_IRQHandler\&quot;])\n        H_IO1[/\&quot;Ambil arus dari ADC1-&amp;gt;DR&lt;br&gt;via buffer DMA\&quot;/]\n        H_P1[\&quot;Clarke Transform&lt;br&gt;Iα = Iu&lt;br&gt;Iβ = (1/√3)·(Iu + 2·Iv)\&quot;]\n        H_P2[\&quot;Park Transform&lt;br&gt;Id = Iα·cosθ + Iβ·sinθ&lt;br&gt;Iq = -Iα·sinθ + Iβ·cosθ\&quot;]\n        H_F1[[\&quot;foc_calculation()&lt;br&gt;PI Controller Update\&quot;]]\n        H_P3[\&quot;Space Vector Modulation&lt;br&gt;SVPWM Sector Lookup\&quot;]\n        H_P4[\&quot;Update Register Capture/Compare&lt;br&gt;TIM1-&amp;gt;CCR1, TIM1-&amp;gt;CCR2, TIM1-&amp;gt;CCR3\&quot;]\n        H_E([\&quot;Exit ISR\&quot;])\n  end\n subgraph SAFETY[\&quot;IV. FAULT HANDLING &amp; SAFETY ROUTINE\&quot;]\n        F_S([\&quot;Start: Fault Check\&quot;])\n        F_D1{\&quot;Error Flag aktif?&lt;br&gt;MC_OVER_VOLT, MC_UNDER_VOLT,&lt;br&gt;MC_OVER_TEMP, MC_BREAK_IN\&quot;}\n        F_OK([\&quot;End: Kondisi Normal\&quot;])\n        F_F1[[\&quot;HAL_TIM_PWM_Stop()\&quot;]]\n        F_P1[\&quot;TIM1-&amp;gt;BDTR &amp;amp;= ~TIM_BDTR_MOE&lt;br&gt;Disable All Gate Drivers\&quot;]\n        F_IO1[/\&quot;Aktifkan Buzzer / LED&lt;br&gt;indikator kesalahan\&quot;/]\n        F_E([\&quot;End: Fault State\&quot;])\n  end\n\n    %% I. INIT\n    I_S --&gt; I_F1 --&gt; I_F2 --&gt; I_F3 --&gt; I_F4 --&gt; I_F5 --&gt; I_F6 --&gt; I_R1 --&gt; I_R2 --&gt; I_F7 --&gt; I_F8 --&gt; I_E\n    I_E -. lanjut ke Main Loop .-&gt; M_S\n\n    %% II. MAIN LOOP\n    M_S --&gt; M_IO1 --&gt; M_R1 --&gt; M_D1\n    M_D1 -- Voltage --&gt; M_R2\n    M_D1 -- Speed --&gt; M_R3\n    M_D1 -- Torque --&gt; M_R4\n    M_R2 --&gt; M_F1\n    M_R3 --&gt; M_F1\n    M_R4 --&gt; M_F1\n    M_F1 -. ulangi loop .-&gt; M_S\n\n    %% III. ISR\n    H_S --&gt; H_IO1 --&gt; H_P1 --&gt; H_P2 --&gt; H_F1 --&gt; H_P3 --&gt; H_P4 --&gt; H_E\n\n    %% IV. FAULT\n    F_S --&gt; F_D1\n    F_D1 -- Tidak --&gt; F_OK\n    F_D1 -- Ya --&gt; F_F1\n    F_F1 --&gt; F_P1 --&gt; F_IO1 --&gt; F_E\n\n     I_S:::term\n     I_F1:::pre\n     I_F2:::pre\n     I_F3:::pre\n     I_F4:::pre\n     I_F5:::pre\n     I_F6:::pre\n     I_R1:::proc\n     I_R2:::proc\n     I_F7:::pre\n     I_F8:::pre\n     I_E:::term\n     M_S:::term\n     M_IO1:::io\n     M_R1:::proc\n     M_D1:::dec\n     M_R2:::proc\n     M_R3:::proc\n     M_R4:::proc\n     M_F1:::pre\n     H_S:::term\n     H_IO1:::io\n     H_P1:::proc\n     H_P2:::proc\n     H_F1:::pre\n     H_P3:::proc\n     H_P4:::proc\n     H_E:::term\n     F_S:::term\n     F_D1:::dec\n     F_OK:::term\n     F_F1:::pre\n     F_P1:::proc\n     F_IO1:::io\n     F_E:::term\n    classDef term fill:#d5e8d4,stroke:#82b366,color:#000\n    classDef prep fill:#fff2cc,stroke:#d6b656,color:#000\n    classDef proc fill:#dae8fc,stroke:#6c8ebf,color:#000\n    classDef pre fill:#e1d5e7,stroke:#9673a6,color:#000\n    classDef dec fill:#f8cecc,stroke:#b85450,color:#000\n    classDef io fill:#ffe6cc,stroke:#d79b00,color:#000&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="MbcN0FOnaQYoXmwlk_NR-1">
