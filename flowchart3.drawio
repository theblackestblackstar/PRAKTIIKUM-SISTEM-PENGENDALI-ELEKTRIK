        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n  theme: redux-color\n---\nflowchart TB\n subgraph INIT[\&quot;I. SYSTEM INITIALIZATION &amp; SETUP\&quot;]\n        I_S([\&quot;Start: Power-On / Reset\&quot;])\n        I_F1[[\&quot;setup()\&quot;]]\n        I_F2[[\&quot;SystemClock_Config()\&quot;]]\n        I_R1[\&quot;Konfigurasi RCC-&amp;gt;APB2ENR&lt;br&gt;Enable TIM1, TIM8, ADC1, GPIOA, GPIOB\&quot;]\n        I_R2[\&quot;Konfigurasi TIM1 (Motor Kiri)&lt;br&gt;dan TIM8 (Motor Kanan) secara paralel\&quot;]\n        I_R3[\&quot;Konfigurasi ADC1-&amp;gt;JSQR&lt;br&gt;Channel Injected Dual Motor&lt;br&gt;(Current Left &amp;amp; Right)\&quot;]\n        I_F3[[\&quot;NVIC_Init()&lt;br&gt;untuk ADC1_2_IRQHandler\&quot;]]\n        I_E([\&quot;End Init\&quot;])\n  end\n subgraph MAIN[\&quot;II. MAIN LOOP / TASK SCHEDULER\&quot;]\n        M_S([\&quot;loop() Super-Loop while 1\&quot;])\n        M_IO1[/\&quot;Baca Protocol Input&lt;br&gt;USART2 / USART3 / ADC Pedal Throttle\&quot;/]\n        M_R1[\&quot;Map &amp;amp; Limiter nilai&lt;br&gt;cmd1 (Motor Left) dan cmd2 (Motor Right)\&quot;]\n        M_D1{\&quot;Field Weakening Aktif?\&quot;}\n        M_R2[\&quot;Hitung nilai minus Id injeksi&lt;br&gt;untuk penambahan RPM\&quot;]\n        M_R3[\&quot;Set Id* = 0\&quot;]\n        M_IO2[/\&quot;Kirim Feedback Frame telemetry&lt;br&gt;send_feedback()\&quot;/]\n  end\n subgraph ISR[\&quot;III. HIGH-FREQUENCY ISR\&quot;]\n        H_S([\&quot;Start ISR: ADC1_2_IRQHandler (Injected ADC)\&quot;])\n        H_IO1[/\&quot;Baca ADC1-&amp;gt;JDR1 &amp;amp; ADC1-&amp;gt;JDR2 (Motor Kiri)&lt;br&gt;Baca ADC1-&amp;gt;JDR3 &amp;amp; ADC1-&amp;gt;JDR4 (Motor Kanan)\&quot;/]\n        H_P1[\&quot;Clarke Transform (Dual Motor Loop)&lt;br&gt;Iα = Iu&lt;br&gt;Iβ = (1/√3)·(Iu + 2·Iv)\&quot;]\n        H_P2[\&quot;Park Transform (Dual Motor Loop)&lt;br&gt;Id = Iα·cosθ + Iβ·sinθ&lt;br&gt;Iq = -Iα·sinθ + Iβ·cosθ\&quot;]\n        H_F1[[\&quot;foc_controller()&lt;br&gt;Dual PI Current Controller\&quot;]]\n        H_P3[\&quot;Kalkulasi Duty Cycle SVPWM&lt;br&gt;untuk kedua motor\&quot;]\n        H_P4[\&quot;Write TIM1-&amp;gt;CCR1..3 (Left)&lt;br&gt;Write TIM8-&amp;gt;CCR1..3 (Right)\&quot;]\n        H_E([\&quot;Exit ISR\&quot;])\n  end\n subgraph SAFETY[\&quot;IV. FAULT HANDLING &amp; SAFETY ROUTINE\&quot;]\n        F_S([\&quot;Start: Fault Check\&quot;])\n        F_D1{\&quot;bat_voltage &amp;lt; LOW_VOLTAGE_LIMIT?&lt;br&gt;(Baterai Lemah)\&quot;}\n        F_D2{\&quot;timeout &amp;gt; MAX_TIMEOUT?&lt;br&gt;(Motor Stall / Timeout Serial)\&quot;}\n        F_D3{\&quot;Over-Current Protection (OCP)&lt;br&gt;terpicu?\&quot;}\n        F_OK([\&quot;End: Kondisi Normal\&quot;])\n        F_P1[\&quot;Shut off Gate Driver&lt;br&gt;TIM1-&amp;gt;BDTR &amp;amp;= ~TIM_BDTR_MOE&lt;br&gt;TIM8-&amp;gt;BDTR &amp;amp;= ~TIM_BDTR_MOE\&quot;]\n        F_F1[[\&quot;motor_stop()\&quot;]]\n        F_E([\&quot;Safety Lock State\&quot;])\n  end\n    I_S --&gt; I_F1\n    I_F1 --&gt; I_F2\n    I_F2 --&gt; I_R1\n    I_R1 --&gt; I_R2\n    I_R2 --&gt; I_R3\n    I_R3 --&gt; I_F3\n    I_F3 --&gt; I_E\n    I_E -. lanjut ke Main Loop .-&gt; M_S\n    M_S --&gt; M_IO1\n    M_IO1 --&gt; M_R1\n    M_R1 --&gt; M_D1\n    M_D1 -- Ya --&gt; M_R2\n    M_D1 -- Tidak --&gt; M_R3\n    M_R2 --&gt; M_IO2\n    M_R3 --&gt; M_IO2\n    M_IO2 -. ulangi loop .-&gt; M_S\n    H_S --&gt; H_IO1\n    H_IO1 --&gt; H_P1\n    H_P1 --&gt; H_P2\n    H_P2 --&gt; H_F1\n    H_F1 --&gt; H_P3\n    H_P3 --&gt; H_P4\n    H_P4 --&gt; H_E\n    F_S --&gt; F_D1\n    F_D1 -- Tidak --&gt; F_D2\n    F_D2 -- Tidak --&gt; F_D3\n    F_D3 -- Tidak --&gt; F_OK\n    F_D1 -- Ya --&gt; F_P1\n    F_D2 -- Ya --&gt; F_P1\n    F_D3 -- Ya --&gt; F_P1\n    F_P1 --&gt; F_F1\n    F_F1 --&gt; F_E\n\n     I_S\n     I_F1\n     I_F2\n     I_R1\n     I_R2\n     I_R3\n     I_F3\n     I_E\n     M_S\n     M_IO1\n     M_R1\n     M_D1\n     M_R2\n     M_R3\n     M_IO2\n     H_S\n     H_IO1\n     H_P1\n     H_P2\n     H_F1\n     H_P3\n     H_P4\n     H_E\n     F_S\n     F_D1\n     F_D2\n     F_D3\n     F_OK\n     F_P1\n     F_F1\n     F_E&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ORXfNNnkzI9JmqYNt1F4-1">
